<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext (HTTP) is permitted ONLY for local development LLM servers
    (Ollama / LM Studio / vLLM running on this device or the Android emulator).
    All other connections must use TLS, so provider API keys never travel in
    plaintext over the network.

    Note: network security config matches exact hostnames only — if you host a
    local server on another machine over your LAN (e.g. http://192.168.x.x),
    add that host as an extra <domain> entry below or use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain>127.0.0.1</domain>
        <domain>::1</domain>
        <domain>10.0.2.2</domain> <!-- Android emulator -> host machine -->
    </domain-config>
</network-security-config>
