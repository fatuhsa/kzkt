# ⚠️ JANGAN commit file keystore.properties (sudah di .gitignore).
# Salin file ini menjadi `keystore.properties` di ROOT proyek, lalu isi
# sesuai keystore ANDA sendiri. Panduan lengkap: lihat BUILD_RELEASE.md

# Path absolut ke file keystore (mis. hasil `keytool -genkeypair`)
storeFile=/home/username/kzkt-release.jks

# Password keystore (saat membuat dengan keytool)
storePassword=password-keystore-rahasia

# Alias kunci
keyAlias=kzkt

# Password kunci (biasanya sama dengan storePassword)
keyPassword=password-kunci-rahasia
