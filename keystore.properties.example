# ⚠️ NEVER commit keystore.properties (it is in .gitignore).
# Copy this file to `keystore.properties` in the PROJECT ROOT and fill in
# YOUR OWN keystore values. Full guide: see BUILD_RELEASE.md

# Absolute path to your keystore file (e.g. from `keytool -genkeypair`)
storeFile=/home/username/kzkt-release.jks

# Keystore password (the one you set when creating the keystore)
storePassword=your-store-password

# Key alias
keyAlias=kzkt

# Key password (usually the same as storePassword)
keyPassword=your-key-password
