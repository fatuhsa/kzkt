# ─────────────────────────────────────────────────────────────────
# KZKT — Git ignore
# Hanya file yang dibutuhkan untuk BUILD yang di-commit.
# Output build, keystore, dan konfigurasi lokal TIDAK pernah di-commit.
# ─────────────────────────────────────────────────────────────────

# ── Android / Gradle build outputs ───────────────────────────────
.gradle/
**/build/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json

# Native / CMake build outputs
.cxx/
.externalNativeBuild/

# OpenCV test binaries & javadoc (tidak dipakai build — hanya opencv/native/libs/*.so yang dipakai)
opencv/native/bin/
opencv/java/javadoc/

# Python virtualenv (bukan bagian dari build)
venv/

# ── Keystore & kredensial signing — JANGAN PERNAH di-commit ──────
keystore.properties
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
kzkt-backup-*.zip

# ── IDE & editor ─────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.freebuff/
opencode.json
*.swp
*~
.DS_Store
Thumbs.db
*.hprof

# ── Konfigurasi lokal / personal ─────────────────────────────────
.claude/settings.local.json
.capture/
captures/
.kotlin/

# Catatan ide pribadi (tidak untuk repo publik)
IDEAS.md

# ── Sisa proyek Python lama (bila ada) ───────────────────────────
__pycache__/
*.pyc

# ── Cache lokal lama ─────────────────────────────────────────────
/models/
.serena/
.remember/
